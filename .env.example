# ---- App ----
APP_ENV=development
LOG_LEVEL=INFO

# ---- Auth ----
# Symmetric secret used to sign/verify JWTs issued to gateway clients.
JWT_SECRET=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Comma-separated static API keys allowed to call the gateway (alternative to JWT).
# Format: key_id:key_secret,key_id2:key_secret2
GATEWAY_API_KEYS=demo:demo-secret-change-me

# ---- Redis (rate limiting) ----
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_BUCKET_CAPACITY=60
RATE_LIMIT_REFILL_PER_SECOND=1

# ---- Upstream AI providers ----
# Real keys — never commit the actual .env file.
ANTHROPIC_API_KEY=sk-ant-your-real-key-here
ANTHROPIC_BASE_URL=https://api.anthropic.com
OPENAI_API_KEY=sk-your-real-key-here
OPENAI_BASE_URL=https://api.openai.com

UPSTREAM_TIMEOUT_SECONDS=30
UPSTREAM_MAX_RETRIES=2

# ---- Guardrails ----
MAX_INPUT_TOKENS=8000
BLOCK_INSECURE_CODE_OUTPUT=true
